# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# project specific
.gitignore
.dockerignore
*.key
docker-compose.dev*
start-dev.sh
.dev.env
.secret*
*.pem
test*
!backend/tests/
!backend/tests/**
TUTORIALS.md
ISO.md
README.md

# general
Thumbs.db
node_modules
dist
www
env/
venv/
ENV/
env.bak/
venv.bak/
.DS_Store
.vscode
.venv
doc/
__*
docker-compose.yml.bak*
cert/
.mongo
*.env*
.env
.env.*
!.env.example
*copy.*
mobile/
/tsconfig.json

# pwa
*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
